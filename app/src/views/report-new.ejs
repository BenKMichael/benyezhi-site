<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Report - Reporting Platform</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            background: #f4f6f8;
            color: #2c3e50;
        }

        main {
            padding: 2rem;
        }

        h1 {
            margin-top: 0;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .category-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            text-decoration: none;
            color: #2c3e50;
            display: block;
        }

        .category-card:hover {
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
        }

        .category-card h2 {
            margin: 0 0 0.5rem 0;
            font-size: 1.1rem;
            color: #0066cc;
        }

        .category-card p {
            margin: 0;
            font-size: 0.9rem;
            color: #777;
        }
    </style>
</head>

<body>
    <%- include('partials/nav', { user: user, can: can, active: 'create' }) %>

    <main>
        <h1>Create Report</h1>`
        <div class="category-grid">
            <% categories.forEach(function (c) { %>
                <a class="category-card" href="/reports/new/<%= c.key %>">
                    <h2><%= c.label %></h2>
                    <p><%= c.chartCount %> charts, last 7 days</p>
                </a>
            <% }); %>
        </div>
    </main>
</body>

</html>
