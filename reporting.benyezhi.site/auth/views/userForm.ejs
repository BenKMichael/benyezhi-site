<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= mode === 'create' ? 'Add User' : 'Edit User' %> - Reporting Platform</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            background: #f4f6f8;
            color: #2c3e50;
        }

        main {
            padding: 2rem;
            max-width: 480px;
        }

        h1 {
            margin-top: 0;
        }

        .card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            margin-top: 1.5rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .hint {
            display: block;
            color: #999;
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        select {
            width: 100%;
            padding: 0.5rem;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 1rem;
        }

        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        button {
            padding: 0.65rem 1.25rem;
            background: #0066cc;
            color: #fff;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
        }

        button:hover {
            background: #0052a3;
        }

        .btn-cancel {
            padding: 0.65rem 1.25rem;
            background: #eee;
            color: #555;
            text-decoration: none;
            border-radius: 4px;
            font-size: 1rem;
        }

        .error {
            color: #d9534f;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <%- include('partials/nav', { user: user, isAdmin: isAdmin, active: 'users' }) %>

    <main>
        <h1><%= mode === 'create' ? 'Add User' : 'Edit User' %></h1>

        <div class="card">
            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>

            <form action="<%= mode === 'create' ? '/users' : `/users/${target.id}/update` %>" method="POST">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" required
                        value="<%= mode === 'edit' ? target.username : '' %>">
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required
                        value="<%= mode === 'edit' ? target.email : '' %>">
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" <%= mode === 'create' ? 'required' : '' %>>
                    <% if (mode === 'edit') { %>
                        <span class="hint">Leave blank to keep the current password.</span>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" name="role" required>
                        <option value="<%= ROLES.BASIC %>" <%= (mode === 'edit' && target.role === ROLES.BASIC) || mode === 'create' ? 'selected' : '' %>>Basic</option>
                        <option value="<%= ROLES.ADMIN %>" <%= mode === 'edit' && target.role === ROLES.ADMIN ? 'selected' : '' %>>Admin</option>
                    </select>
                </div>

                <div class="actions">
                    <button type="submit"><%= mode === 'create' ? 'Create User' : 'Save Changes' %></button>
                    <a href="/users" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</body>

</html>
