<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Reporting Platform</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            background: #f4f6f8;
            color: #2c3e50;
        }

        main {
            padding: 2rem;
        }

        h1 {
            margin-top: 0;
        }

        .widget {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            margin-top: 1.5rem;
        }

        .widget h2 {
            margin-top: 0;
            font-size: 1.1rem;
            color: #2c3e50;
        }

        .chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .chart-row .widget {
            margin-top: 0;
        }

        /* ~1/4 of a 1080p display's height (1080 / 4 = 270px) -- Chart.js
           derives canvas height from its container when
           maintainAspectRatio: false is set, so this is the actual cap. */
        .chart-container {
            position: relative;
            height: 270px;
        }

        @media (max-width: 700px) {
            .chart-row {
                grid-template-columns: 1fr;
            }
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        th,
        td {
            text-align: left;
            padding: 0.5rem;
            border-bottom: 1px solid #eee;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 240px;
        }

        th {
            color: #777;
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .table-wrap {
            overflow-x: auto;
        }
    </style>
</head>

<body>
    <%- include('partials/nav', { user: user, isAdmin: isAdmin, active: 'dashboard' }) %>

    <main>
        <h1>Dashboard</h1>
        <p>Overview of visitor analytics collected via the reporting API, last 7 days.</p>

        <div class="widget">
            <h2>Visitors Over Time</h2>
            <div class="chart-container">
                <canvas id="visitorsOverTimeChart"></canvas>
            </div>
        </div>

        <div class="chart-row">
            <div class="widget">
                <h2>Visitor Location</h2>
                <div class="chart-container">
                    <canvas id="locationChart"></canvas>
                </div>
            </div>
            <div class="widget">
                <h2>Browser Capabilities</h2>
                <div class="chart-container">
                    <canvas id="capabilityChart"></canvas>
                </div>
            </div>
        </div>

        <div class="widget">
            <h2>Recent Events</h2>
            <div class="table-wrap">
                <table id="eventsGrid">
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>Type</th>
                            <th>URL</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="widget">
            <h2>Recent Sessions</h2>
            <div class="table-wrap">
                <table id="sessionsGrid">
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>User Agent</th>
                            <th>Country</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="/dashboard.js"></script>
</body>

</html>
