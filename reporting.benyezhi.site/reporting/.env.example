PORT=3002
# Must match auth's SESSION_SECRET exactly -- this is what lets reporting
# verify the signature on the analytics_sid cookie auth issues.
SESSION_SECRET=changeme
COOKIE_SECURE=false

DB_HOST=mysql-db
DB_PORT=3306
DB_USER=reporting_user
DB_PASSWORD=reporting_password
DB_NAME=analytics_db
DB_CONNECT_TIMEOUT=2000
